# ========== AI 智能客服助手 环境配置模板 ==========
# 复制为 .env 并填写真实值

# --- 大模型（阿里云百炼，必填才能启用真 AI）---
# 百炼控制台 -> API-KEY 管理 创建，形如 sk-xxxx
DASHSCOPE_API_KEY=你的百炼API_Key
# OpenAI 兼容接口地址（保持默认即可）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型：qwen3-max / qwen-plus / qwen-turbo（按账号可用/免费额度选择）
LLM_MODEL=qwen3-max
LLM_TIMEOUT=40

# --- 数据库 ---
# 默认 ai_customer.db（同目录），可改成绝对路径
DB_PATH=

# --- 微信公众平台（公众号服务器验证用）---
# 与公众号后台「服务器配置」里填写的 Token 一致（自己随便定，字母数字）
WECHAT_TOKEN=ai-customer-service-token
# 公众号 AppID/AppSecret（客服消息、小程序端才需要）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 用户类型区分：给企业用户的消息/菜单使用
USER_TYPES=电商用户,企业用户

# --- 服务 ---
# wechat_bot.py 监听端口
PORT=8001
# Web 日志文件
LOG_FILE=app.log
DEBUG=false
